# apps/backend/.env 로 복사해서 사용
# docker compose로 실행하면 DB·Redis·S3 주소(DATABASE_URL, REDIS_URL, TASKIQ_REDIS_URL, TEST_DATABASE_URL,
# S3_ENDPOINT_URL 등)는 compose가 컨테이너용 주소(postgres, redis, s3)로 덮어쓴다.
# 아래 localhost 값은 호스트에서 uv로 실행할 때 쓰인다.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
# 로그인 성공·실패 후 돌려보낼 프론트엔드 주소
FRONTEND_BASE_URL=http://localhost:5173

DATABASE_URL=postgres://oz:oz@localhost:5432/oz_backoffice
REDIS_URL=redis://localhost:6379/0
TASKIQ_REDIS_URL=redis://localhost:6379/1

# openssl rand -hex 32
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_COOKIE_SECURE=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console의 "승인된 리디렉션 URI"에 같은 값을 등록한다 (백엔드가 콜백을 받는다)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=nextrunners.co.kr

# Airtable 수강생 명단 (KDT 학생관리툴 Base). 토큰은 읽기 범위만:
# data.records:read, schema.bases:read
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# 같은 Base의 테이블 ID (tbl...). 테이블 이름을 넣어도 동작한다
AIRTABLE_STUDENT_TABLE_ID=
AIRTABLE_BOOTCAMP_TABLE_ID=

# AWS S3 (로컬은 compose의 floci 에뮬레이터, 운영은 S3_ENDPOINT_URL을 비우고 IAM 역할 사용)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=oz-backoffice-local
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# X-Forwarded-For를 믿을 프록시(IP·CIDR, JSON 배열). 운영은 nginx 주소를 넣는다. 예: ["10.0.0.0/8"]
TRUSTED_PROXIES=[]

# 메일·SMS 발송. console은 로그로 출력(개발용, 운영에서는 발송 거부).
# gmail은 서비스 계정 + 도메인 전체 위임(gmail.send)으로 GMAIL_SENDER 계정이 보낸다.
# GOOGLE_SERVICE_ACCOUNT_JSON에는 키 파일 JSON을 한 줄로 작은따옴표로 감싸 넣는다:
#   python3 -c "import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))" key.json
MAIL_DRIVER=console
SMS_DRIVER=console
MAIL_SENDER_NAME=오즈코딩스쿨
GMAIL_SENDER=
GOOGLE_SERVICE_ACCOUNT_JSON=

# 통합 테스트 DB는 .env가 아니라 환경변수로 넘긴다:
#   compose: docker compose exec api pytest  (compose가 TEST_DATABASE_URL을 설정함)
#   로컬:    TEST_DATABASE_URL=postgres://oz:oz@localhost:5432/oz_backoffice_test uv run pytest
