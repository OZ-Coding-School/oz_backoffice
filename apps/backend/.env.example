# apps/backend/.env 로 복사해서 사용
# docker compose로 실행하면 DB·Redis·S3 주소(DATABASE_URL, REDIS_URL, TASKIQ_REDIS_URL, TEST_DATABASE_URL,
# S3_ENDPOINT_URL 등)는 compose가 컨테이너용 주소(postgres, redis, s3)로 덮어쓴다.
# 아래 localhost 값은 호스트에서 uv로 실행할 때 쓰인다.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgres://oz:oz@localhost:5432/oz_backoffice
REDIS_URL=redis://localhost:6379/0
TASKIQ_REDIS_URL=redis://localhost:6379/1

# openssl rand -hex 32
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=nextrunners.co.kr

# AWS S3 (로컬은 compose의 floci 에뮬레이터, 운영은 S3_ENDPOINT_URL을 비우고 IAM 역할 사용)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=oz-backoffice-local
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# 통합 테스트 DB는 .env가 아니라 환경변수로 넘긴다:
#   compose: docker compose exec api pytest  (compose가 TEST_DATABASE_URL을 설정함)
#   로컬:    TEST_DATABASE_URL=postgres://oz:oz@localhost:5432/oz_backoffice_test uv run pytest
