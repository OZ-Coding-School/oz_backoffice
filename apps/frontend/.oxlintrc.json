{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }]
  },
  "overrides": [
    {
      "files": ["src/routes/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ],
  "ignorePatterns": ["dist", "src/routeTree.gen.ts", "src/api/schema.gen.ts", "tools", "public/mockServiceWorker.js"]
}
